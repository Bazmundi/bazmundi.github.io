---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';
import { filterPostsByCategory, getCategoryIndex } from '../../../lib/blog';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const categoryIndex = getCategoryIndex(posts);
	return categoryIndex.map((category) => ({
		params: { category: category.slug },
		props: { category },
	}));
}

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const { category } = Astro.props;
const categoryPosts = filterPostsByCategory(posts, category.slug);
const pageTitle = `${category.name} | ${SITE_TITLE}`;
const pageDescription = `Posts filed under ${category.name}.`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription ?? SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1200px, 100%);
				margin: 0 auto;
				padding: 0 1.5rem 2rem;
			}
			.category-header {
				text-align: center;
				margin: 2.5rem 0 2rem;
			}
			.category-header .eyebrow {
				margin: 0;
				text-transform: uppercase;
				letter-spacing: 0.2em;
				font-size: 0.75rem;
				color: rgb(var(--gray));
			}
			.category-header h1 {
				margin: 0.5rem 0;
			}
			.category-count {
				margin: 0 0 1rem;
				color: rgb(var(--gray));
			}
			.back-link {
				color: var(--accent);
				text-decoration: none;
			}
			.post-list {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.post-card {
				width: calc(50% - 1rem);
			}
			.post-card * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			.post-card img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			.post-card a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			.post-card a:hover h4,
			.post-card a:hover .date {
				color: var(--accent);
			}
			.post-card a:hover img {
				box-shadow: var(--box-shadow);
			}
			.empty-state {
				text-align: center;
				color: rgb(var(--gray));
				margin: 2rem 0;
			}
			@media (max-width: 720px) {
				.post-list {
					gap: 0.5em;
				}
				.post-card {
					width: 100%;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="category-header">
				<p class="eyebrow">Category</p>
				<h1>{category.name}</h1>
				<p class="category-count">
					{category.count} {category.count === 1 ? 'post' : 'posts'}
				</p>
				<a class="back-link" href="/blog">All posts</a>
			</div>
			{
				categoryPosts.length ? (
					<ul class="post-list">
						{categoryPosts.map((post) => (
							<li class="post-card">
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="empty-state">No posts yet for this category.</p>
				)
			}
		</main>
		<Footer />
	</body>
</html>
