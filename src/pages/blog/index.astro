---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getCategoryGroups, getCategoryIndex, getCategoryTabs } from '../../lib/blog';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = posts.slice(0, 5);
const categoryItems = getCategoryIndex(posts);
const categoryGroups = getCategoryGroups(categoryItems);
const categoryTabs = getCategoryTabs(categoryGroups);
const archiveMonthFormatter = new Intl.DateTimeFormat('en', { month: 'long' });
const getArchiveKey = (date) =>
	`${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
const archiveItems = [];
const archiveIndex = new Map();

for (const post of posts) {
	const key = getArchiveKey(post.data.pubDate);
	let item = archiveIndex.get(key);
	if (!item) {
		item = {
			key,
			year: String(post.data.pubDate.getFullYear()),
			monthLabel: archiveMonthFormatter.format(post.data.pubDate),
			count: 0,
		};
		archiveIndex.set(key, item);
		archiveItems.push(item);
	}
	item.count += 1;
}

const archiveGroups = [];
const archiveGroupIndex = new Map();

for (const item of archiveItems) {
	let group = archiveGroupIndex.get(item.year);
	if (!group) {
		group = { year: item.year, months: [] };
		archiveGroupIndex.set(item.year, group);
		archiveGroups.push(group);
	}
	group.months.push(item);
}

const seenArchiveKeys = new Set();
const postsWithArchive = posts.map((post) => {
	const key = getArchiveKey(post.data.pubDate);
	const isFirstInMonth = !seenArchiveKeys.has(key);
	if (isFirstInMonth) {
		seenArchiveKeys.add(key);
	}
	return { post, archiveKey: key, isFirstInMonth };
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			body {
				height: 100vh;
				overflow: hidden;
			}
			main {
				width: min(1200px, 100%);
				margin: 0 auto;
				padding: 0 1.5rem 2rem;
				display: flex;
				flex-direction: column;
				min-height: 0;
				height: calc(100vh - var(--header-height, 0px));
				box-sizing: border-box;
			}
			.blog-layout {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 260px;
				gap: 2.5rem;
				align-items: start;
				flex: 1;
				min-height: 0;
				height: 100%;
			}
			.blog-layout > section,
			.blog-layout > aside {
				min-height: 0;
				min-width: 0;
				height: 100%;
				overflow-y: auto;
				padding-right: 0.5rem;
				scroll-behavior: smooth;
			}
			.post-list {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.post-card {
				width: calc(50% - 1rem);
			}
			.post-card * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			.post-list > .post-card:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			.post-list > .post-card:first-child img {
				width: 100%;
			}
			.post-list > .post-card:first-child .title {
				font-size: 2.369rem;
			}
			.post-card img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			.post-card a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			.post-card a:hover h4,
			.post-card a:hover .date {
				color: var(--accent);
			}
			.post-card a:hover img {
				box-shadow: var(--box-shadow);
			}
			.sidebar {
				display: flex;
				flex-direction: column;
				gap: 2rem;
			}
			.sidebar-block h3 {
				margin: 0 0 0.75rem;
				font-size: 0.95rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: rgb(var(--gray-dark));
			}
			.sidebar-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			.sidebar-list li {
				display: flex;
				justify-content: space-between;
				gap: 0.75rem;
			}
			.sidebar-list a {
				color: rgb(var(--black));
				text-decoration: none;
				transition: color 0.2s ease;
			}
			.sidebar-list a:hover,
			.sidebar-list li:hover a {
				color: var(--accent);
			}
			.sidebar-list .count {
				color: rgb(var(--gray));
				font-size: 0.85em;
				white-space: nowrap;
			}
			.category-tabs,
			.archive-tabs {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem 0.5rem;
				margin-bottom: 1rem;
			}
			.category-tab,
			.archive-tab {
				background: none;
				border: 0;
				padding: 0;
				font: inherit;
				text-decoration: none;
				color: rgb(var(--black));
				font-size: 0.85rem;
				border-bottom: 2px solid transparent;
				padding-bottom: 0.1rem;
				cursor: pointer;
				transition: color 0.2s ease, border-color 0.2s ease;
			}
			.category-tab.is-active,
			.archive-tab.is-active {
				color: var(--accent);
				border-bottom-color: var(--accent);
			}
			.category-tab:hover,
			.archive-tab:hover {
				color: var(--accent);
				border-bottom-color: var(--accent);
			}
			.category-tab.is-disabled {
				color: rgb(var(--gray));
				opacity: 0.5;
				cursor: not-allowed;
				pointer-events: none;
			}
			.category-group,
			.archive-group {
				margin-top: 0.75rem;
			}
			.back-to-top {
				position: fixed;
				top: 1rem;
				left: 1rem;
				z-index: 20;
				background: rgb(var(--gray-light));
				color: rgb(var(--black));
				text-decoration: none;
				font-size: 0.75rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				padding: 0.35rem 0.6rem;
				border-radius: 999px;
				border: 1px solid rgba(var(--gray), 0.4);
				box-shadow: 0 4px 12px rgba(var(--gray), 0.2);
				transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
			}
			.back-to-top:hover {
				color: var(--accent);
				border-color: var(--accent);
				transform: translateY(-1px);
			}
			.sidebar-empty {
				margin: 0;
				color: rgb(var(--gray));
			}
			@media (max-width: 1024px) {
				body {
					height: auto;
					overflow: auto;
				}
				main {
					display: block;
					min-height: auto;
					height: auto;
				}
				.blog-layout {
					grid-template-columns: 1fr;
					flex: none;
					min-height: auto;
				}
				.blog-layout > section,
				.blog-layout > aside {
					overflow: visible;
					padding-right: 0;
					scroll-behavior: auto;
				}
			}
			@media (max-width: 720px) {
				.post-list {
					gap: 0.5em;
				}
				.post-card {
					width: 100%;
					text-align: center;
				}
				.post-list > .post-card:first-child {
					margin-bottom: 0;
				}
				.post-list > .post-card:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<a class="back-to-top" href="#top" data-back-to-top>Back to top</a>
		<main id="top">
			<div class="blog-layout">
				<section>
					<ul class="post-list">
						{
							postsWithArchive.map(({ post, archiveKey, isFirstInMonth }) => (
								<li
									class="post-card"
									id={isFirstInMonth ? `archive-${archiveKey}` : undefined}
								>
									<a href={`/blog/${post.id}/`}>
										{post.data.heroImage && (
											<Image width={720} height={360} src={post.data.heroImage} alt="" />
										)}
										<h4 class="title">{post.data.title}</h4>
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</a>
								</li>
							))
						}
					</ul>
					<Footer />
				</section>
				<aside class="sidebar">
					<div class="sidebar-block">
						<h3>Meanderings</h3>
						<ul class="sidebar-list">
							{recentPosts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</li>
							))}
						</ul>
					</div>
					<div class="sidebar-block">
						<h3>Categories</h3>
						{categoryItems.length ? (
							<>
								<nav class="category-tabs" aria-label="Category index">
									{categoryTabs.map((tab) =>
										tab.enabled ? (
											<button class="category-tab" type="button" data-key={tab.key}>
												{tab.key}
											</button>
										) : (
											<button
												class="category-tab is-disabled"
												type="button"
												disabled
												aria-disabled="true"
												data-key={tab.key}
											>
												{tab.key}
											</button>
										),
									)}
								</nav>
								{categoryGroups.map((group) => (
									<div class="category-group" data-key={group.key} id={`cat-${group.anchor}`}>
										<ul class="sidebar-list">
											{group.categories.map((category) => (
												<li>
													<a href={`/blog/category/${category.slug}/`}>
														{category.name}
													</a>
													<span class="count">{category.count}</span>
												</li>
											))}
										</ul>
									</div>
								))}
							</>
						) : (
							<p class="sidebar-empty">No categories yet.</p>
						)}
					</div>
					<div class="sidebar-block">
						<h3>Archaeological Drival</h3>
						{archiveGroups.length ? (
							<>
								<nav class="archive-tabs" aria-label="Archive years">
									{archiveGroups.map((group) => (
										<button class="archive-tab" type="button" data-year={group.year}>
											{group.year}
										</button>
									))}
								</nav>
								{archiveGroups.map((group) => (
									<div class="archive-group" data-year={group.year}>
										<ul class="sidebar-list">
											{group.months.map((archive) => (
												<li>
													<a href={`#archive-${archive.key}`}>{archive.monthLabel}</a>
													<span class="count">{archive.count}</span>
												</li>
											))}
										</ul>
									</div>
								))}
							</>
						) : (
							<p class="sidebar-empty">No archives yet.</p>
						)}
					</div>
				</aside>
			</div>
		</main>
		<script>
			const categoryTabs = Array.from(
				document.querySelectorAll('.category-tabs .category-tab'),
			);
			const categoryGroups = Array.from(
				document.querySelectorAll('.category-group'),
			);
			const enabledTabs = categoryTabs.filter((tab) => !tab.disabled);

			const setActiveCategoryTab = (key) => {
				categoryTabs.forEach((tab) => {
					const isActive = tab.dataset.key === key;
					tab.classList.toggle('is-active', isActive);
					if (isActive) {
						tab.setAttribute('aria-current', 'true');
					} else {
						tab.removeAttribute('aria-current');
					}
				});

				categoryGroups.forEach((group) => {
					group.hidden = group.dataset.key !== key;
				});
			};

			if (enabledTabs.length) {
				const initialKey = enabledTabs[0].dataset.key;
				setActiveCategoryTab(initialKey);

				enabledTabs.forEach((tab) => {
					tab.addEventListener('click', () => setActiveCategoryTab(tab.dataset.key));
				});
			}

			const archiveTabs = Array.from(
				document.querySelectorAll('.archive-tabs .archive-tab'),
			);
			const archiveGroups = Array.from(
				document.querySelectorAll('.archive-group'),
			);

			const setActiveArchiveTab = (year) => {
				archiveTabs.forEach((tab) => {
					const isActive = tab.dataset.year === year;
					tab.classList.toggle('is-active', isActive);
					if (isActive) {
						tab.setAttribute('aria-current', 'true');
					} else {
						tab.removeAttribute('aria-current');
					}
				});

				archiveGroups.forEach((group) => {
					group.hidden = group.dataset.year !== year;
				});
			};

			if (archiveTabs.length) {
				const initialYear = archiveTabs[0].dataset.year;
				setActiveArchiveTab(initialYear);

				archiveTabs.forEach((tab) => {
					tab.addEventListener('click', () => setActiveArchiveTab(tab.dataset.year));
				});
			}

			const updateHeaderHeight = () => {
				const header = document.querySelector('header');
				if (!header) return;
				document.documentElement.style.setProperty(
					'--header-height',
					`${header.offsetHeight}px`,
				);
			};

			updateHeaderHeight();
			window.addEventListener('resize', updateHeaderHeight);

			const backToTop = document.querySelector('[data-back-to-top]');
			const scrollPanels = [
				document.querySelector('.blog-layout > section'),
				document.querySelector('.blog-layout > aside'),
			].filter(Boolean);

			if (backToTop && scrollPanels.length) {
				backToTop.addEventListener('click', (event) => {
					event.preventDefault();
					scrollPanels.forEach((panel) => {
						panel.scrollTo({ top: 0, behavior: 'smooth' });
					});
				});
			}
		</script>
	</body>
</html>
