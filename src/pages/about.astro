---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import AboutHeroImage from "../assets/artistic_monkey_trans.png";

const pageTitle = "About Me";
const pageDescription = "Lorem ipsum dolor sit amet";
---

<Base title={pageTitle} description={pageDescription} bodyClass="about-page">
	<section class="section">
		<div class="container">
			<div class="row justify-center">
				<div class="lg:col-8">
					<h1 class="h2 text-center mb-6">{pageTitle}</h1>
					<div class="relative">
						<Image
							src={AboutHeroImage}
							alt=""
							width={960}
							height={540}
							class="rounded-lg"
							loading="eager"
						/>
					</div>
					<div class="content mt-6">
						<p>
Lorem chimpum dolor sit amet,
consectetur OOH OOH adipiscing elit,
sed do eiusmod tempor CHESTUS THUMPUS incididunt ut labore et dolore magna BANANA.

Vitae ultricies leo, integer malesuada nunc vel risus commodo SCREECHUS MAXIMUS.
Adipiscing enim eu turpis egestas pretium,
euismod elementum nisi quis eleifend quam… EE-EE-EE-EE!

In hac habitasse platea dictumst:
WHO STOLE MY MANGO?!
						</p>

					</div>
				</div>
			</div>
		</div>
	</section>
</Base>

<style>
	body.about-page {
		background: #000;
		color: #f4f1e8;
	}
</style>
