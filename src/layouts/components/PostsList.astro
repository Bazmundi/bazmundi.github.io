---
import type { CollectionEntry } from "astro:content";
import Post from "@/layouts/components/post.astro";

type Props = {
  posts: CollectionEntry<"blog">[];
};

const { posts } = Astro.props;
---

<div class="row">
  {
    posts.map((post) => (
      <div class="col-12 mb-4 sm:col-6">
        <Post {...post} />
      </div>
    ))
  }
</div>
